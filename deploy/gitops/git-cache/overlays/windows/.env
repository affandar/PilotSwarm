# Values are rewritten by deploy/scripts/lib/substitute-env.mjs and consumed by
# the generated ConfigMap plus the git-cache replacements component.
REPO_NAME=placeholder
REPO_URL=https://example.invalid/repository.git
CACHE_ROOT=C:\git-cache
CACHE_HOSTPATH=C:\git-cache
FETCH_INTERVAL_SECONDS=3600
FETCH_JITTER_SECONDS=300
CACHE_NOT_READY_TAINT_KEY=pilotswarm.io/cache-not-ready
CACHE_MAX_UNAVAILABLE=1
CACHE_MEM_LIMIT=1Gi
GIT_CACHE_IMAGE=placeholder.azurecr.io/pilotswarm-worker-win:placeholder
WORKLOAD_IDENTITY_CLIENT_ID=00000000-0000-0000-0000-000000000000
GIT_CACHE_PAT_KEYVAULT_NAME=placeholder
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
GIT_CACHE_PAT_SECRET_NAME=placeholder
GIT_CACHE_DAEMONSET_NAME=git-cache-placeholder-windows
GIT_CACHE_SERVICE_ACCOUNT_NAME=pilotswarm-git-cache-placeholder
GIT_CACHE_NODE_PATCHER_NAME=pilotswarm-git-cache-placeholder-node-patcher
GIT_CACHE_SECRET_PROVIDER_CLASS_NAME=pilotswarm-git-cache-placeholder-secrets
GIT_CACHE_SCRIPTS_CONFIG_MAP_NAME=pilotswarm-git-cache-placeholder-scripts
