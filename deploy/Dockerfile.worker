# Single-stage: install from npm (linux binary published to registry)
# trixie-slim (Debian 13, glibc 2.41) required by duroxide-linux-x64-gnu >= 0.1.25
# (prebuilds link against GLIBC_2.39; bookworm-slim is 2.36 and crashes at dlopen).
FROM node:24-trixie-slim

# Base runtime deps:
#   ca-certificates  HTTPS
#   git              git-repo-worker.js shells out to clone/fetch/reset the
#                    enlistment from the node-local mirror (git-cache collocation).
#   curl             fetch the PowerShell tarball below (slim has no curl).
#   libicu-dev       PowerShell's globalization runtime dependency (pulls the
#                    correct libicu soname for this Debian release).
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates git curl libicu-dev \
 && rm -rf /var/lib/apt/lists/*

# The node-local git-cache mirror this worker clones/fetches from is written by
# the git-cache daemon (root) and mounted read-only; the worker runs as the
# non-root `node` user (below), so git's "dubious ownership" guard would abort
# every clone/fetch. Trust all repo paths in the SYSTEM git config — safe.directory
# is honored ONLY from system/global config files, never from -c or GIT_CONFIG_*
# env, so this must be baked into the image (not passed via the DaemonSet env).
RUN git config --system --add safe.directory '*'

# PowerShell (pwsh) — the SQL agent skills/tooling drive `powershell`/`pwsh`, and
# PowerShell Core runs natively on Linux, so a Linux worker image satisfies the
# "must run PowerShell" requirement without Windows containers. Installed from the
# distro-agnostic release tarball (the packages.microsoft.com apt repo lags new
# Debian releases like trixie). See docs/proposals/windows-worker-image-followup.md
# for why a native Windows image build was deferred.
ARG PWSH_VERSION=7.4.6
RUN curl -fsSL "https://github.com/PowerShell/PowerShell/releases/download/v${PWSH_VERSION}/powershell-${PWSH_VERSION}-linux-x64.tar.gz" -o /tmp/pwsh.tar.gz \
 && mkdir -p /opt/microsoft/powershell/7 \
 && tar zxf /tmp/pwsh.tar.gz -C /opt/microsoft/powershell/7 \
 && chmod +x /opt/microsoft/powershell/7/pwsh \
 && ln -s /opt/microsoft/powershell/7/pwsh /usr/bin/pwsh \
 && rm /tmp/pwsh.tar.gz \
 && pwsh --version

WORKDIR /app

# Copy workspace root and package manifests
COPY package.json package-lock.json ./
COPY packages/sdk/package.json ./packages/sdk/
COPY packages/app/package.json ./packages/app/
# horizon-store package.json must be present BEFORE `npm ci` so npm creates the
# node_modules/@pilotswarm/horizon-store workspace symlink the SDK's dynamic
# import("@pilotswarm/horizon-store") resolves at runtime (optional EnhancedFactStore).
COPY packages/horizon-store/package.json ./packages/horizon-store/
COPY scripts/postinstall.js ./scripts/
# `npm ci` enforces the committed package-lock.json so worker image rebuilds
# from this SHA are byte-reproducible. Matches deploy/Dockerfile.starter.
#
# NPM_REGISTRY lets a build that cannot reach registry.npmjs.org (corporate
# networks routinely block it) install from a mirror instead. Defaults to the
# public registry, so an unset build arg behaves exactly as before. npm's
# replace-registry-host (default `npmjs`) rewrites the lockfile's
# registry.npmjs.org `resolved` URLs onto the configured registry, so the
# lockfile stays authoritative and the image stays reproducible.
ARG NPM_REGISTRY=https://registry.npmjs.org/
ENV npm_config_registry=${NPM_REGISTRY}
RUN npm ci --omit=dev --force

# Copy built SDK dist + bundled plugins, worker script, and app plugins
COPY packages/sdk/dist/ ./packages/sdk/dist/
COPY packages/sdk/plugins/ ./packages/sdk/plugins/
COPY packages/sdk/examples/worker.js ./packages/sdk/examples/
# git-repo-worker entrypoint (AKS git-hydration): reused-enlistment worker that
# reconciles from a node-local git-cache mirror before each job. Selected via a
# `command:` override in deploy/gitops/git-repo-worker; harmless otherwise.
COPY packages/sdk/examples/git-repo-worker.js ./packages/sdk/examples/
COPY packages/app/tui/plugins/ ./packages/app/tui/plugins/

# api-client (plain ESM) — the SDK's dist/web/api-connection.js imports it at
# load time, so it must be present even though workers use direct { store } mode.
COPY packages/sdk/api/index.js packages/sdk/api/index.d.ts ./packages/sdk/api/
COPY packages/sdk/api/src/ ./packages/sdk/api/src/

# horizon-store built output + runtime-read migrations (the migrator reads the
# numbered migrations/*.sql from disk relative to dist/). Sibling layout matters:
# dist/src/horizon-migrator.js resolves ../../migrations.
COPY packages/horizon-store/dist/ ./packages/horizon-store/dist/
COPY packages/horizon-store/migrations/ ./packages/horizon-store/migrations/

# Copy model providers config (if present)
COPY .model_providers.json* ./

# Run as the built-in node user (non-root)
USER node

ENTRYPOINT ["node", "packages/sdk/examples/worker.js"]
