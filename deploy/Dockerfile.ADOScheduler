# pilotswarm-ado-scheduler — the ADO placement provider (control-plane singleton).
#
# Headless Node service, packaged exactly like deploy/Dockerfile.worker (same
# base image, same reproducible `npm ci --omit=dev` from the committed lockfile).
# The only differences from the worker image are the ENTRYPOINT (scheduler.js
# instead of worker.js) and a leaner copy set: the scheduler never executes
# orchestrations, so it needs no SDK/app plugins, no model-providers catalog,
# and no LLM runtime. It imports pilotswarm-sdk only for the CMS/duroxide store
# client (observe) plus `pg` + `@azure/identity` (affinity table + AAD/ADO
# tokens) — all already runtime deps of packages/sdk.
#
# trixie-slim (Debian 13, glibc 2.41) required by duroxide-linux-x64-gnu >= 0.1.25
# (prebuilds link against GLIBC_2.39; bookworm-slim is 2.36 and crashes at dlopen).
FROM node:24-trixie-slim

# Install CA certificates for HTTPS (ADO REST + AAD token endpoints).
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy workspace root and package manifests. All workspace package.json files
# must be present before `npm ci` so npm builds the workspace symlink tree the
# committed lockfile describes (matches deploy/Dockerfile.worker). The SDK's
# dynamic import("@pilotswarm/horizon-store") is optional and never triggered by
# the scheduler, but the manifest must exist for `npm ci` to resolve the graph.
COPY package.json package-lock.json ./
COPY packages/sdk/package.json ./packages/sdk/
COPY packages/app/package.json ./packages/app/
COPY packages/horizon-store/package.json ./packages/horizon-store/
COPY scripts/postinstall.js ./scripts/

# `npm ci` enforces the committed package-lock.json so scheduler image rebuilds
# from this SHA are byte-reproducible. Matches deploy/Dockerfile.worker.
#
# NPM_REGISTRY lets a build that cannot reach registry.npmjs.org install from a
# mirror instead; defaults to the public registry so an unset arg is a no-op.
ARG NPM_REGISTRY=https://registry.npmjs.org/
ENV npm_config_registry=${NPM_REGISTRY}
RUN npm ci --omit=dev --force

# Built SDK dist + the scheduler boot script. No plugins / model-providers:
# the scheduler observes and queues; it runs no Copilot turns.
COPY packages/sdk/dist/ ./packages/sdk/dist/
COPY packages/sdk/examples/ado_scheduler.js ./packages/sdk/examples/

# api-client (plain ESM) — the SDK's dist/web/api-connection.js imports it at
# load time, so it must be present even though the scheduler uses direct
# { store } mode (mirrors deploy/Dockerfile.worker).
COPY packages/sdk/api/index.js packages/sdk/api/index.d.ts ./packages/sdk/api/
COPY packages/sdk/api/src/ ./packages/sdk/api/src/

# Run as the built-in node user (non-root).
USER node

ENTRYPOINT ["node", "packages/sdk/examples/ado_scheduler.js"]
