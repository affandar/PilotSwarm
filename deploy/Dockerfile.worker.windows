# Windows worker image — parity with deploy/Dockerfile.worker (Linux) for Windows AKS.
#
# Unlike the Linux image, this Dockerfile does NOT run `npm ci`. The Windows-native
# worker tree (node_modules incl. duroxide-windows-x64, dist/, worker.js, plugins,
# horizon-store) is prepared ONCE by the build job (see .github/workflows/build-windows-worker.yml)
# and staged into ./stage. This image just copies that staged tree — the same tree
# the ADO zip bundle contains. One build, two package shapes.
#
# servercore (not nanoserver) because the duroxide-windows-x64 prebuild links the
# MSVC runtime, which servercore carries and bare nanoserver does not.
FROM mcr.microsoft.com/windows/servercore:ltsc2022

# Install Node 24 (pin to match the Linux image's NODE_VERSION).
ARG NODE_VERSION=24.13.1
SHELL ["powershell", "-Command", "$ErrorActionPreference = 'Stop';"]
RUN Invoke-WebRequest -Uri "https://nodejs.org/dist/v$env:NODE_VERSION/node-v$env:NODE_VERSION-win-x64.zip" -OutFile node.zip ; \
    Expand-Archive node.zip -DestinationPath C:\ ; \
    Rename-Item "C:\node-v$env:NODE_VERSION-win-x64" C:\nodejs ; \
    Remove-Item node.zip ; \
    setx /M PATH ('C:\nodejs;' + $env:PATH)

WORKDIR C:\app

# Copy the pre-staged runnable tree (produced by the build job). This mirrors the
# Linux Dockerfile.worker COPY manifest, but sourced from ./stage so node_modules
# (with the win32-x64-msvc .node) is byte-identical to the zip bundle.
COPY stage/ .

# Run as a non-admin user parity is left to the deployment's securityContext on
# Windows (no USER node equivalent baked here).
ENTRYPOINT ["node", "packages\\sdk\\examples\\worker.js"]
